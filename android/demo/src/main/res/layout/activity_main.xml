<?xml version="1.0" encoding="utf-8"?>
<!--
  WatchPlay :demo — the whole UI: the mirrored scene on top, a button, and a live stats log.

  The scene lives inside a container rather than being declared as a WebView here, because
  `06-rendering.md` §3.2 step 1 requires the WebView to be created from a `densityDpi = 160`
  configuration context so that `1 CSS px == 1 physical px` and therefore `1vmin == 1%` of the shorter
  side. MainActivity does that programmatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/scene_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="#05070c" />

    <Button
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/start_mirroring" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/stats_placeholder"
            android:textSize="12sp" />

    </ScrollView>

</LinearLayout>
