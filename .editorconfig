root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Do not trim trailing double-spaces in Markdown: they are hard line breaks.
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{c,h,cpp,hpp}]
indent_size = 4

[*.gradle]
indent_size = 4
