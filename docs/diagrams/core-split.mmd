        direction TB
        queue["跨核队列（深度 2）"] --> decode["解码任务<br/>JPEG 硬解"] --> backbuf["PSRAM 后缓冲写入"] --> te["TE 同步"] --> qspi["QSPI DMA 刷屏"] --> panel["466×466 AMOLED 面板"]
    end

    parse -->|"视频分块"| queue
    decode -. "解码完成信号" .-> feedback
