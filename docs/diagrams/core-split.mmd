flowchart LR
    subgraph core0["Core 0 — BLE 协议栈"]
        direction TB
        ble["BLE 协议栈<br/>BT controller + Bluedroid"] --> gatt["GATT 回调<br/>notify / write"] --> parse["WatchPlay 帧解析<br/>+ 视频分块重组"]
        parse --> feedback["FEEDBACK 生成<br/>+ Credit 归还"]
        feedback --> touch["TOUCH 采集<br/>→ 编码 → 发送"]
