flowchart LR
    subgraph phone["手机端 (Android)"]
        direction TB
        ui["HTML + CSS 手表 UI"]
        gl["OpenGL 绘制到纹理"]
        codec["MediaCodec 编码<br/>JPEG / H.264"]
        framing["协议封装 / Credit 流控"]
        tx["TransportModule"]
        touchmap["触控映射"]
        inject["注入 WebView"]

        ui -->|"WebView 捕获"| gl --> codec --> framing --> tx
        tx -. "触控回传" .-> touchmap --> inject
        inject -.-> ui
    end

    subgraph watch["手表端（任意 MCU / SoC）"]
        direction TB
        bearer["传输层"]
        reassemble["协议解包 / 重组"]
        decode["解码<br/>JPEG / H.264"]
        frames["帧缓冲<br/>防撕裂"]
        panel["手表屏幕<br/>形状由 DISPLAY 上报"]
        touch["触控采集"]

        bearer --> reassemble --> decode --> frames --> panel
        panel -.- touch
        touch -. "上行触控" .-> bearer
    end

    tx <-->|"BLE GATT / CoC<br/>经典蓝牙 · Wi-Fi"| bearer
